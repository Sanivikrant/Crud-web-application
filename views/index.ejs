<%- include('layout/header') %>

<!-- Custom Styles -->
<style>
    body {
        background: linear-gradient(to right, #f8f9fa, #e9ecef);
    }

    .card-glass {
        backdrop-filter: blur(10px);
        background: rgba(255, 255, 255, 0.85);
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        animation: fadeInUp 0.6s ease;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .table thead th {
        vertical-align: middle;
        background: #343a40;
        color: #fff;
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .table img {
        border-radius: 8px;
        object-fit: cover;
        transition: transform 0.3s;
    }

    .table img:hover {
        transform: scale(1.1);
    }

    .fa-edit, .fa-trash {
        transition: transform 0.3s, color 0.3s;
        cursor: pointer;
    }

    .fa-edit:hover {
        color: #0d6efd !important;
        transform: scale(1.2);
    }

    .fa-trash:hover {
        color: #dc3545 !important;
        transform: scale(1.2);
    }

    .alert {
        font-weight: 500;
        animation: fadeIn 0.5s ease-in-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 768px) {
        .table {
            font-size: 0.9rem;
        }
    }
</style>

<!-- Main Container -->
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <% if (message) { %>
                <div class="alert alert-dismissible fade show alert-<%= message.type %>" role="alert">
                    <button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Close"></button>
                    <strong><%= message.message %></strong>
                </div>
            <% } %>

            <div class="card-glass">
                <% if (users.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover text-center align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Image</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach((row, index) => { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td>
                                            <img src="<%= row.image %>" width="50" height="50" class="img-thumbnail" alt="User Image">
                                        </td>
                                        <td><%= row.name %></td>
                                        <td><%= row.email %></td>
                                        <td><%= row.phone %></td>
                                        <td>
                                            <a href="/edit/<%= row._id %>" class="text-success">
                                                <i class="fas fa-edit fa-lg mx-1"></i>
                                            </a>
                                            <a href="/delete/<%= row._id %>" class="text-danger">
                                                <i class="fas fa-trash fa-lg mx-1"></i>
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <h4 class="text-center text-secondary mt-5">No users found in the database!</h4>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('layout/footer') %>
